rules_version = '2';

/**
 * Azhary Boutique — Firestore Security Rules
 *
 * This file is the authorization control. Everything in the browser is an
 * affordance; a hidden button is still a reachable SDK call. If these rules and
 * src/domain/authorization.ts ever disagree, these rules are correct.
 *
 * Invariants (SECURITY.md):
 *   - `allow read, write: if true` appears nowhere. Not temporarily, not for the
 *     emulator.
 *   - Roles come from BOTH the Firebase Auth custom claim and users/{uid}, and
 *     the lower of the two wins. See `effectiveOwner()`.
 *   - `active` is read live from Firestore, so deactivation takes effect on the
 *     employee's very next request rather than when their ID token expires.
 *   - Clients can never write `users`, `system`, or `invoices`. Those belong to
 *     Cloud Functions using the Admin SDK, which bypasses these rules.
 *   - Financial and legal history — payments, invoices, reservations, audit
 *     logs, terms — is not deletable by ANY role, including OWNER.
 *   - The final match block denies everything not explicitly allowed above it.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ *
     * Identity
     * ------------------------------------------------------------------ */

    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    /*
     * A signed-in user with an existing, active profile document.
     *
     * The `active` flag is read from Firestore rather than from the token
     * because a custom claim cannot express deactivation promptly: claims are
     * minted into the ID token and stay valid until it expires, up to an hour.
     * An employee dismissed at 09:00 would otherwise keep full access until
     * 10:00. This costs one document read per rule evaluation, which is the
     * correct trade for immediate revocation.
     */
    function isActive() {
      return hasProfile() && profile().active == true;
    }

    function claimRole() {
      return isSignedIn() ? request.auth.token.get('role', '') : '';
    }

    function documentRole() {
      return isActive() ? profile().get('role', '') : '';
    }

    /*
     * OWNER requires BOTH sources to say OWNER.
     *
     * The claim alone would defer a demotion until the token expires. The
     * document alone would make the role a database field, which a future rule
     * bug could expose to a client write. Requiring both means a demotion takes
     * effect immediately (document caps the stale claim) while a promotion waits
     * for the token to refresh (under-privileged is the harmless direction).
     */
    function isOwner() {
      return isActive() && claimRole() == 'OWNER' && documentRole() == 'OWNER';
    }

    function isEmployee() {
      return isActive()
        && (claimRole() == 'OWNER' || claimRole() == 'STAFF')
        && (documentRole() == 'OWNER' || documentRole() == 'STAFF');
    }

    function isStaff() {
      return isEmployee() && !isOwner();
    }

    /* ------------------------------------------------------------------ *
     * Field-level helpers
     * ------------------------------------------------------------------ */

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /** No field in `fields` differs between the stored and incoming document. */
    function unchanged(fields) {
      return !changedKeys().hasAny(fields.toSet());
    }

    /** The write touches only fields drawn from `fields`. */
    function onlyChanges(fields) {
      return changedKeys().hasOnly(fields.toSet());
    }

    /** The actor recorded on a document is the caller, not someone else. */
    function actorIsSelf() {
      return request.resource.data.get('createdBy', request.auth.uid) == request.auth.uid;
    }

    /* ------------------------------------------------------------------ *
     * system — bootstrap sentinel
     *
     * Owned entirely by Cloud Functions. The client learns whether bootstrap is
     * needed by calling `getBootstrapState`, never by reading this document, so
     * that no unauthenticated read rule has to exist anywhere in the database.
     * ------------------------------------------------------------------ */

    match /system/{documentId} {
      allow read, write: if false;
    }

    /* ------------------------------------------------------------------ *
     * users
     *
     * Readable so the interface can show who is signed in and, for the owner,
     * manage staff. NEVER writable by a client: role and active are the
     * privilege switches, and role assignment runs as a Cloud Function.
     * Rejecting the whole write is simpler and safer than trying to allow a
     * "safe subset" of fields on a privilege-bearing document.
     * ------------------------------------------------------------------ */

    match /users/{userId} {
      allow get: if isActive() && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();
      allow create, update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * businessProfile · settings — owner-configured, employee-readable
     * ------------------------------------------------------------------ */

    match /businessProfile/{documentId} {
      allow read: if isEmployee();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    /*
     * A stored VAT rate must be one the boutique may actually charge.
     *
     * Oman's standard rate is 5%, with zero-rating for some supplies. A rate
     * outside that set is a configuration mistake, not a commercial decision —
     * and an invoice carrying the wrong VAT rate is a matter for the tax
     * authority, so the check belongs here and not only in the interface. The
     * field is optional, so a settings write that does not mention VAT passes.
     */
    function vatRateIsPermitted() {
      return !('vatRatePercent' in request.resource.data)
        || request.resource.data.vatRatePercent == 0
        || request.resource.data.vatRatePercent == 5;
    }

    /* Money settings must be whole, non-negative baisa — never a rial float. */
    function lateFeeIsWellFormed() {
      return !('lateFeePerDay' in request.resource.data)
        || (request.resource.data.lateFeePerDay is int
            && request.resource.data.lateFeePerDay >= 0);
    }

    function pickupThresholdIsWellFormed() {
      return !('minPickupPaymentPercent' in request.resource.data)
        || (request.resource.data.minPickupPaymentPercent is number
            && request.resource.data.minPickupPaymentPercent >= 0
            && request.resource.data.minPickupPaymentPercent <= 100);
    }

    match /settings/{documentId} {
      // Staff read settings because the VAT rate and pickup threshold drive the
      // screens they use daily. Reading configuration is not changing it.
      allow read: if isEmployee();

      // Owner-only, and only values the financial engine can honour. Staff
      // changing VAT, the late-fee rate or the cancellation scale would let the
      // shop floor rewrite the commercial terms of every future booking.
      allow create, update: if isOwner()
        && vatRateIsPermitted()
        && lateFeeIsWellFormed()
        && pickupThresholdIsWellFormed();

      allow delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * termsVersions — immutable once written
     *
     * Reservations reference a version by id and snapshot its text. Editing a
     * version in place would silently rewrite the terms a customer already
     * agreed to, so a change means a NEW version.
     * ------------------------------------------------------------------ */

    match /termsVersions/{versionId} {
      allow read: if isEmployee();
      allow create: if isOwner();
      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * counters — transaction-safe number allocation
     * ------------------------------------------------------------------ */

    match /counters/{counterId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && request.resource.data.current == 1;
      // Strictly +1. A client cannot rewind a sequence to reissue a number that
      // an existing invoice or reservation already carries.
      allow update: if isEmployee()
        && request.resource.data.current == resource.data.current + 1;
      allow delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * dresses — operational inventory
     * ------------------------------------------------------------------ */

    match /dresses/{dressId} {
      allow read: if isEmployee();

      // Codes are allocated by a counter transaction and are how staff identify
      // a garment. Rewriting one would break every reference to it.
      allow create: if isEmployee() && request.resource.data.code is string;
      allow update: if isEmployee() && unchanged(['code', 'createdAt', 'createdBy']);

      allow delete: if isOwner();

      /*
       * Purchase cost is commercially sensitive and staff must not see it.
       * Firestore rules cannot hide one field of a document, so the cost lives
       * in its own subcollection where a rule can actually cover it. A rule on
       * the parent would be unenforceable theatre.
       */
      match /private/{documentId} {
        allow read, write: if isOwner();
      }
    }

    /* ------------------------------------------------------------------ *
     * customers
     * ------------------------------------------------------------------ */

    match /customers/{customerId} {
      allow read: if isEmployee();

      // `archived` must exist from creation so the default customer list — which
      // filters on it — cannot silently omit a new record.
      allow create: if isEmployee()
        && request.resource.data.code is string
        && request.resource.data.archived == false;

      allow update: if isEmployee() && unchanged(['code', 'createdAt', 'createdBy']);

      // Customers are archived, never deleted: reservations, payments and
      // invoices reference them, and that history must stay resolvable.
      allow delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * reservations
     *
     * Never deletable, by anyone. A reservation carries payments, an invoice and
     * agreed terms; deleting it would orphan financial history. Cancellation is
     * a status, not a deletion.
     * ------------------------------------------------------------------ */

    match /reservations/{reservationId} {
      allow read: if isEmployee();

      /*
       * NO client write path. Creating a reservation means checking availability
       * and booking atomically, which requires reading a query inside a
       * transaction — something the client SDK cannot do. A browser-side check
       * is a time-of-check/time-of-use race, so `createReservation` runs as a
       * Cloud Function and the Admin SDK bypasses these rules.
       *
       * Status changes and date changes go through Functions for the same
       * reason: both have to re-run the availability check.
       */
      allow create: if false;

      // Notes are the one field with no bearing on availability, pricing or
      // lifecycle, so an employee may edit them directly.
      allow update: if isEmployee()
        && onlyChanges(['notes', 'updatedAt', 'updatedBy']);

      allow delete: if false;
    }

    match /reservationItems/{itemId} {
      allow read: if isEmployee();

      /*
       * Function-only. These carry the blocking intervals that decide
       * availability; a client able to write them could book a dress by
       * inventing an item, or free one by deleting somebody else's.
       */
      allow create, update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * fittings · accessories · waitlist — operational
     * ------------------------------------------------------------------ */

    /*
     * Fittings are appointments, not holds: they do not affect dress
     * availability, so ordinary employee CRUD is safe here.
     */
    match /fittings/{fittingId} {
      allow read: if isEmployee();
      allow create: if isEmployee()
        && request.resource.data.reservationId is string
        && request.resource.data.status is string;
      allow update: if isEmployee() && unchanged(['reservationId', 'createdAt', 'createdBy']);
      allow delete: if isEmployee();
    }

    /*
     * Accessory money must be whole, non-negative baisa — never a rial float.
     *
     * Checked per field and only when the field is present, so a write that does
     * not mention a price still passes. A fractional price here would reach an
     * invoice through the reservation's pricing snapshot, and the integer-baisa
     * invariant the whole financial engine rests on would be broken from the
     * catalogue inwards.
     */
    function accessoryMoneyIsWellFormed(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is int && request.resource.data[field] >= 0);
    }

    match /accessories/{accessoryId} {
      allow read: if isEmployee();

      allow create, update: if isEmployee()
        && accessoryMoneyIsWellFormed('rentalPrice')
        && accessoryMoneyIsWellFormed('salePrice')
        && accessoryMoneyIsWellFormed('securityDeposit');

      /*
       * Deletion is owner-only and remains available for a mistyped entry that
       * was never used. The application itself never calls it: `setAccessoryStatus`
       * retires instead, because past reservations reference accessories by id
       * and a deleted entry would leave their revenue unattributable.
       */
      allow delete: if isOwner();
    }

    /*
     * The waitlist records interest; it grants nothing and blocks nothing, so
     * employees manage it directly.
     */
    match /waitlist/{entryId} {
      allow read: if isEmployee();
      allow create: if isEmployee()
        && request.resource.data.status == 'Waiting'
        && request.resource.data.dressId is string
        && request.resource.data.customerId is string;
      allow update: if isEmployee() && unchanged(['dressId', 'customerId', 'createdAt']);
      allow delete: if isEmployee();
    }

    /* ------------------------------------------------------------------ *
     * financialEvents — the append-only ledger (Phase 5)
     *
     * Payments, refunds, reversals, deposit movements, late fees and
     * cancellation waivers are all events in one collection, because they are
     * all answers to "what happened to this reservation's money" and a balance
     * is the reduction over them.
     *
     * NO CLIENT WRITE PATH AT ALL.
     *
     * Two independent reasons, either sufficient:
     *
     * 1. Whether a payment is permitted depends on the balance, and the balance
     *    is a reduction over every event already posted. That is a query read
     *    followed by a write, which the client SDK cannot do inside a
     *    transaction — so a client-side check is a time-of-check/time-of-use
     *    race, and two tills would both take the same outstanding balance.
     *
     * 2. A ledger whose entries a client can write is not a ledger. The
     *    document id IS the idempotency key, which is what makes a retry
     *    converge on one event rather than two; a client free to choose ids
     *    could defeat that by construction.
     *
     * Update and delete are refused to EVERY role, owner included. A mistake is
     * corrected by appending a reversal, never by editing history. This is the
     * accounting principle the whole phase rests on: the record must answer
     * what happened, not merely what is currently believed.
     * ------------------------------------------------------------------ */

    match /financialEvents/{eventId} {
      allow read: if isEmployee();
      allow create, update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * payments — superseded by financialEvents
     *
     * Phase 2 modelled payments as a client-written collection with a void
     * flag. Phase 5 replaced it: voiding mutates a posted entry, and the
     * balance it belongs to cannot be computed safely on a client. The
     * collection is closed rather than removed, so any document written before
     * the change stays readable and auditable.
     * ------------------------------------------------------------------ */

    match /payments/{paymentId} {
      allow read: if isEmployee();
      allow create, update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * invoices — issued and frozen by a Cloud Function
     *
     * Number allocation and immutability cannot be trusted to a client, so no
     * client write path exists at all. The Admin SDK bypasses these rules.
     * ------------------------------------------------------------------ */

    match /invoices/{invoiceId} {
      allow read: if isEmployee();
      allow create, update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * damageLogs — evidence, retained
     * ------------------------------------------------------------------ */

    match /damageLogs/{damageLogId} {
      allow read: if isEmployee();
      allow create, update: if isEmployee();
      allow delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * notificationLogs — the communication record, append-only
     *
     * WhatsApp V1 is click-to-chat. The application opens a `wa.me` link; it
     * never transmits anything and cannot observe what happened next. So an
     * entry records only what was actually seen — `Prepared`, `Opened` or
     * `Copied` — and the words Sent, Delivered and Read appear nowhere.
     *
     * ONE IMMUTABLE ENTRY PER ACTION.
     *
     * Phase 2 modelled this as a single document with a mutable `openedAt`.
     * Phase 8 replaced that, for two reasons:
     *
     * 1. An employee who opens WhatsApp twice has contacted the customer
     *    twice — the second may be a genuine follow-up after no reply. A
     *    single timestamp can record only the first, so the history would
     *    understate what the boutique actually did.
     * 2. The entry carries the exact message text that was prepared. That is a
     *    snapshot, like an invoice: "what did we actually tell her?" must have
     *    an answer six months later, after the template has been rewritten and
     *    the reservation's dates have moved. A record that can be edited
     *    answers nothing.
     *
     * So update is refused to every role, and each action appends.
     *
     * `employeeId` must be the caller: an employee cannot log a message
     * attributed to a colleague.
     * ------------------------------------------------------------------ */

    function communicationStatusIsHonest() {
      return request.resource.data.status in ['Prepared', 'Opened', 'Copied'];
    }

    match /notificationLogs/{logId} {
      allow read: if isEmployee();

      allow create: if isEmployee()
        && communicationStatusIsHonest()
        && request.resource.data.employeeId == request.auth.uid;

      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * auditLogs — append-only, owner-readable
     *
     * Employees append (their own actions produce entries) but cannot read the
     * trail, edit it or delete from it. An audit log that its subjects can amend
     * records nothing.
     * ------------------------------------------------------------------ */

    match /auditLogs/{auditLogId} {
      allow read: if isOwner();
      allow create: if isEmployee()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * Deny by default. This block is always last.
     * ------------------------------------------------------------------ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
