# Azhary Boutique — environment configuration template
#
# Copy to .env.development or .env.production and fill in real values.
# NEVER commit a populated .env file.
#
# Everything prefixed with VITE_ is compiled into the public browser bundle.
# Firebase Web config values are NOT secrets — they identify the project, and
# security is enforced by Firestore/Storage rules (see SECURITY.md §7).
#
# Service-account keys, admin credentials and private keys must NEVER appear
# here or anywhere under src/. They belong only in Cloud Functions runtime config.

# --- Firebase Web configuration -------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Application environment ----------------------------------------------
# 'development' | 'production'
VITE_APP_ENV=development

# Demo data is only permitted when this is true.
# PRODUCTION MUST SET THIS TO false (specification §58).
VITE_DEMO_MODE=false

# Connect to the local Firebase Emulator Suite instead of live Firebase.
VITE_USE_EMULATORS=false
